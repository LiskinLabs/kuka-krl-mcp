{
  "name": "kuka-krl-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for KUKA KRL (KSS 8.3-8.7) robot programming, industrial safety linting, system variables, error catalog, and live controller bridge.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kuka-krl-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test test/server.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kuka",
    "krl",
    "robotics",
    "krc4",
    "krc5",
    "kss",
    "industrial-automation",
    "cursor",
    "antigravity",
    "claude"
  ],
  "author": "LiskinLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiskinLabs/kuka-krl-mcp.git"
  },
  "homepage": "https://github.com/LiskinLabs/kuka-krl-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
